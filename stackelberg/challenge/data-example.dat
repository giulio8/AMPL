

#########################################################################
#  data-example.dat   – paste your instance here and run “ampl mod dat”.
#########################################################################

#####  1. GRID GEOMETRY  ################################################
# 0 = wall (black), 1 = traversable (white)
param NROWS := 4;
param NCOLS := 4;


param grid: 1 2 3 4 :=
1         1  1  1  1   # row 1
2         1  0  1  1   # row 2
3         1  1  1  0   # row 3
4         1  1  1  1 ; # row 4

#####  2. TARGET CO‑ORDINATES  ##########################################
set TARGETS :=
    (2,4)
    (3,3) ;

#####  3. PAY‑OFF TABLES  ###############################################
param RD_capture  := 
2,4  10 
3,3   10;
param RD_no_capture := 
2,4  -5  
3,3  -5 ;

param RA_capture    := 
2,4 -10   
3,3  -10 ;

param RA_no_capture := 
2,4  10 
3,3  10 ;

#####  4. HORIZON  ######################################################
param TMAX := 3;

#########################################################################
