set P := 1 2;
set I := a1 a2;

# Payoff: 
# Giocatore 1 ottiene:
# - 1 se gioca a1 contro a1
# - 0 se gioca a1 contro a2
# - 0 se gioca a2 contro a1
# - 1 se gioca a2 contro a2

param U :=
[1,2,*,*]:
       a1   a2 :=
  a1    1    0
  a2    0    1

[2,1,*,*]:
       a1   a2 :=
  a1    0    1
  a2    1    0;

param M :=
1 1
2 1;